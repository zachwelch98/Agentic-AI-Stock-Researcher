# Anthropic (Claude) — required
ANTHROPIC_API_KEY=

# Finnhub — free tier key, https://finnhub.io/register — required (profile/fundamentals/news/quote)
# Price history uses Yahoo Finance's unofficial chart API instead (no key needed) —
# Finnhub's free tier lacks historical candles, and FMP's free tier restricts them to
# a small symbol whitelist.
FINNHUB_API_KEY=

# LangSmith tracing — optional but expected for the grading checkpoint
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-ai-stock-researcher

# SEC EDGAR requires a descriptive User-Agent identifying the requester
SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"

# Optional overrides — Sonnet backs the planner/screener-judgment/synthesizer nodes,
# Haiku backs the 4 researcher nodes
SONNET_MODEL=claude-sonnet-5
HAIKU_MODEL=claude-haiku-4-5-20251001
